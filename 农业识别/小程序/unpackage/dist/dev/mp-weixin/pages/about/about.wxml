<view class="about-page"><view class="hero-section"><image class="hero-bg" src="/static/ui/backgrounds/bg-about-hero.png" mode="aspectFill"></image><view class="hero-overlay"></view><view class="hero-blob hero-blob-left"></view><view class="hero-blob hero-blob-right"></view><image class="hero-decor hero-decor-tl" src="/static/ui/decor/leaf-corner-tl.png" mode="aspectFit"></image><image class="hero-decor hero-decor-br" src="/static/ui/decor/leaf-corner-br.png" mode="aspectFit"></image><view class="hero-content"><view class="brand-chip"><image class="brand-chip-icon" src="/static/ui/icons/ic-knowledge.svg" mode="aspectFit"></image><text class="brand-chip-text">知识库</text></view><view class="hero-title">关于系统</view><view class="hero-subtitle">智能识别 · 科学防治 · 农技知识沉淀</view></view></view><view class="content-wrap"><view class="intro-card card"><image class="intro-bg" src="/static/ui/backgrounds/bg-leaf-closeup.png" mode="aspectFill"></image><view class="intro-mask"></view><view class="intro-content"><view class="intro-icon-wrap"><image class="intro-icon" src="/static/ui/icons/ic-recognize.svg" mode="aspectFit"></image></view><view class="intro-text-wrap"><text class="intro-title">基于 ResNet50 的病虫害识别及防治预警系统</text><text class="intro-desc">面向农户与种植管理场景，提供作物病害识别、知识查询、历史追踪和社区交流等功能。</text></view></view></view><view class="stats-row"><view class="stat-card card"><view class="stat-icon-box green"><image class="stat-icon" src="/static/ui/icons/ic-knowledge.svg" mode="aspectFit"></image></view><text class="stat-number">{{$root.g0}}</text><text class="stat-label">作物类型</text></view><view class="stat-card card"><view class="stat-icon-box orange"><image class="stat-icon" src="/static/ui/icons/ic-warning.svg" mode="aspectFit"></image></view><text class="stat-number">{{$root.g1}}</text><text class="stat-label">病害条目</text></view></view><view class="feature-card card"><view class="section-head"><view class="section-mark"></view><text class="section-title">核心能力</text></view><view class="feature-grid"><view class="feature-item"><view class="feature-icon-wrap"><image class="feature-icon" src="/static/ui/icons/ic-recognize.svg" mode="aspectFit"></image></view><text class="feature-title">智能识别</text><text class="feature-desc">上传叶片图片，快速返回作物、病害、置信度与严重程度。</text></view><view class="feature-item"><view class="feature-icon-wrap"><image class="feature-icon" src="/static/ui/icons/ic-solution.svg" mode="aspectFit"></image></view><text class="feature-title">防治建议</text><text class="feature-desc">结合病害知识库，展示症状特征、用药方案和预防措施。</text></view><view class="feature-item"><view class="feature-icon-wrap"><image class="feature-icon" src="/static/ui/icons/ic-history.svg" mode="aspectFit"></image></view><text class="feature-title">历史追踪</text><text class="feature-desc">自动保存识别记录，便于持续观察作物健康变化。</text></view><view class="feature-item"><view class="feature-icon-wrap"><image class="feature-icon" src="/static/ui/icons/ic-community.svg" mode="aspectFit"></image></view><text class="feature-title">社区交流</text><text class="feature-desc">支持图文发帖、点赞与评论，沉淀种植经验。</text></view></view></view><view class="knowledge-card card"><view class="section-head section-head-between"><view class="section-head-left"><view class="section-mark"></view><text class="section-title">病害知识库</text></view><text data-event-opts="{{[['tap',[['refreshData',['$event']]]]]}}" class="section-link" bindtap="__e">刷新</text></view><view class="search-box"><image class="search-icon" src="/static/ui/icons/ic-knowledge.svg" mode="aspectFit"></image><input class="search-input" placeholder="搜索作物或病害名称" placeholder-class="search-placeholder" data-event-opts="{{[['input',[['__set_model',['','keyword','$event',['trim']]]]],['blur',[['$forceUpdate']]]]}}" value="{{keyword}}" bindinput="__e" bindblur="__e"/><block wx:if="{{keyword}}"><text data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="search-clear" bindtap="__e">清空</text></block></view><scroll-view class="crop-scroll" scroll-x="{{true}}"><view class="crop-chip-row"><view data-event-opts="{{[['tap',[['selectCrop',['']]]]]}}" class="{{['crop-chip',(activeCrop==='')?'active':'']}}" bindtap="__e">全部</view><block wx:for="{{cropTypes}}" wx:for-item="crop" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['selectCrop',['$0'],[[['cropTypes','id',crop.id,'name']]]]]]]}}" class="{{['crop-chip',(activeCrop===crop.name)?'active':'']}}" bindtap="__e">{{''+crop.name+''}}</view></block></view></scroll-view><block wx:if="{{loading}}"><view class="state-box"><text class="state-text">正在加载知识库...</text></view></block><block wx:else><block wx:if="{{$root.g2===0}}"><view class="empty-box"><image class="empty-image" src="/static/ui/empty/empty-knowledge.png" mode="aspectFit"></image><text class="empty-title">暂无匹配内容</text><text class="empty-desc">可以更换关键词，或切换到全部作物查看知识条目</text></view></block><block wx:else><view class="disease-groups"><block wx:for="{{$root.l1}}" wx:for-item="group" wx:for-index="__i1__" wx:key="cropType"><view class="disease-group"><view data-event-opts="{{[['tap',[['toggleGroup',['$0'],[[['filteredGroups','cropType',group.$orig.cropType,'cropType']]]]]]]}}" class="group-head" bindtap="__e"><view class="group-title-wrap"><view class="group-leaf-dot"></view><text class="group-title">{{group.$orig.cropType||'未分类作物'}}</text><text class="group-count">{{group.g3+" 条"}}</text></view><text class="group-arrow">{{expandedMap[group.$orig.cropType]?'收起':'展开'}}</text></view><block wx:if="{{expandedMap[group.$orig.cropType]}}"><view class="disease-list"><block wx:for="{{group.l0}}" wx:for-item="item" wx:for-index="__i2__" wx:key="id"><view data-event-opts="{{[['tap',[['openDiseaseDetail',['$0'],[[['filteredGroups','cropType',group.$orig.cropType],['items','id',item.$orig.id]]]]]]]}}" class="disease-item" bindtap="__e"><view class="disease-top"><view class="disease-name-wrap"><text class="disease-name">{{item.$orig.name}}</text><block wx:if="{{item.$orig.nameEn}}"><text class="disease-name-en">{{item.$orig.nameEn}}</text></block></view><view class="{{['severity-badge',itemBadgeClassMap[item.$orig.id]||'']}}">{{item.m0}}</view></view><block wx:if="{{item.$orig.description}}"><view class="disease-desc"><text>{{item.$orig.description}}</text></view></block><view class="disease-actions"><block wx:if="{{item.$orig.solutions}}"><view data-event-opts="{{[['tap',[['openDiseaseDetail',['$0'],[[['filteredGroups','cropType',group.$orig.cropType],['items','id',item.$orig.id]]]]]]]}}" class="mini-action" catchtap="__e"><image class="mini-action-icon" src="/static/ui/icons/ic-solution.svg" mode="aspectFit"></image><text>防治方案</text></view></block><block wx:if="{{item.$orig.preventionMethods}}"><view data-event-opts="{{[['tap',[['openDiseaseDetail',['$0'],[[['filteredGroups','cropType',group.$orig.cropType],['items','id',item.$orig.id]]]]]]]}}" class="mini-action" catchtap="__e"><image class="mini-action-icon" src="/static/ui/icons/ic-warning.svg" mode="aspectFit"></image><text>预防措施</text></view></block></view></view></block></view></block></view></block></view></block></block></view></view><block wx:if="{{detailVisible}}"><view data-event-opts="{{[['tap',[['closeDiseaseDetail',['$event']]]]]}}" class="detail-mask" bindtap="__e"></view></block><block wx:if="{{detailVisible}}"><view class="detail-sheet"><view class="sheet-handle"></view><view class="sheet-head"><view><text class="sheet-title">{{selectedDisease?selectedDisease.name:'病害详情'}}</text><text class="sheet-subtitle">{{selectedDisease?selectedDisease.cropType:''}}</text></view><text data-event-opts="{{[['tap',[['closeDiseaseDetail',['$event']]]]]}}" class="sheet-close" bindtap="__e">关闭</text></view><scroll-view class="detail-scroll" scroll-y="{{true}}"><block wx:if="{{selectedDisease}}"><view class="detail-content"><view class="detail-summary-card"><view class="detail-summary-head"><image class="detail-summary-icon" src="/static/ui/icons/ic-knowledge.svg" mode="aspectFit"></image><view class="detail-summary-text"><text class="detail-main-name">{{selectedDisease.name}}</text><block wx:if="{{selectedDisease.nameEn}}"><text class="detail-sub-name">{{selectedDisease.nameEn}}</text></block></view><view class="{{['severity-badge',selectedDiseaseBadgeClass]}}">{{$root.m1}}</view></view></view><block wx:if="{{selectedDisease.description}}"><view class="detail-block"><text class="detail-block-title">症状特征</text><text class="detail-block-text">{{selectedDisease.description}}</text></view></block><block wx:if="{{selectedDisease.solutions}}"><view class="detail-block"><text class="detail-block-title">防治方案</text><text class="detail-block-text">{{selectedDisease.solutions}}</text></view></block><block wx:if="{{selectedDisease.preventionMethods}}"><view class="detail-block"><text class="detail-block-title">预防措施</text><text class="detail-block-text">{{selectedDisease.preventionMethods}}</text></view></block></view></block></scroll-view></view></block></view>