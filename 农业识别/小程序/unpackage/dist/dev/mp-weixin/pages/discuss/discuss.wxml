<view class="discuss-page"><view class="hero-section"><image class="hero-bg" src="/static/ui/backgrounds/bg-discuss-hero.png" mode="aspectFill"></image><view class="hero-overlay"></view><view class="hero-blob hero-blob-left"></view><view class="hero-blob hero-blob-right"></view><image class="hero-decor hero-decor-tl" src="/static/ui/decor/leaf-corner-tl.png" mode="aspectFit"></image><image class="hero-decor hero-decor-br" src="/static/ui/decor/leaf-corner-br.png" mode="aspectFit"></image><view class="hero-content"><view class="brand-chip"><image class="brand-chip-icon" src="/static/ui/icons/ic-community.svg" mode="aspectFit"></image><text class="brand-chip-text">讨论</text></view><view class="hero-title">农业社区</view><view class="hero-subtitle">交流种植经验，分享识别案例与防治心得</view></view></view><view class="content-wrap"><view class="quick-card card"><view class="quick-left"><view class="quick-icon-wrap"><image class="quick-icon" src="/static/ui/icons/ic-post.svg" mode="aspectFit"></image></view><view class="quick-meta"><text class="quick-title">发布农技动态</text><text class="quick-desc">支持图文内容，最多上传 9 张图片</text></view></view><view data-event-opts="{{[['tap',[['openPostSheet',['$event']]]]]}}" class="quick-btn" bindtap="__e">发帖</view></view><view class="feed-card card"><view class="section-head section-head-between"><view class="section-head-left"><view class="section-mark"></view><text class="section-title">社区动态</text></view><text data-event-opts="{{[['tap',[['refreshPosts',['$event']]]]]}}" class="section-link" bindtap="__e">刷新</text></view><block wx:if="{{$root.g0}}"><view class="state-box"><text class="state-text">正在加载社区内容...</text></view></block><block wx:else><block wx:if="{{$root.g1===0}}"><view class="empty-box"><image class="empty-image" src="/static/ui/empty/empty-posts.png" mode="aspectFit"></image><text class="empty-title">社区还没有帖子</text><text class="empty-desc">发布第一条图文内容，分享你的作物管理经验</text></view></block><block wx:else><view class="post-list"><block wx:for="{{$root.l1}}" wx:for-item="post" wx:for-index="__i0__" wx:key="post_id"><view class="post-card"><view class="post-head"><view class="avatar">{{post.m0}}</view><view class="post-user"><view class="post-name-row"><text class="post-name">{{post.$orig.username||'农友'}}</text><text class="post-status">交流中</text></view><text class="post-time">{{post.$orig.create_time}}</text></view></view><block wx:if="{{post.$orig.content}}"><view class="post-content"><text class="{{['post-text',(post.g2)?'collapsed':'']}}">{{post.$orig.content}}</text><block wx:if="{{post.g3>80}}"><text data-event-opts="{{[['tap',[['toggleExpand',['$0'],[[['posts','post_id',post.$orig.post_id]]]]]]]}}" class="expand-link" bindtap="__e">{{post.$orig.expanded?'收起':'展开全文'}}</text></block></view></block><block wx:if="{{post.g4}}"><view class="post-images"><block wx:for="{{post.l0}}" wx:for-item="img" wx:for-index="index" wx:key="index"><image class="post-image" src="{{img.m1}}" mode="aspectFill" data-event-opts="{{[['tap',[['previewPostImages',['$0',index],[[['posts','post_id',post.$orig.post_id,'images']]]]]]]}}" bindtap="__e"></image></block></view></block><view class="post-actions"><view data-event-opts="{{[['tap',[['toggleLike',['$0'],[[['posts','post_id',post.$orig.post_id]]]]]]]}}" class="{{['action-item',(post.$orig.is_liked)?'liked':'']}}" bindtap="__e"><image class="action-icon" src="/static/ui/icons/ic-like.svg" mode="aspectFit"></image><text>{{post.$orig.like_count||0}}</text></view><view data-event-opts="{{[['tap',[['openComments',['$0'],[[['posts','post_id',post.$orig.post_id]]]]]]]}}" class="action-item" bindtap="__e"><image class="action-icon" src="/static/ui/icons/ic-comment.svg" mode="aspectFit"></image><text>{{post.$orig.comment_count||0}}</text></view></view><block wx:if="{{post.$orig.comment_count}}"><view class="comment-preview"><text data-event-opts="{{[['tap',[['openComments',['$0'],[[['posts','post_id',post.$orig.post_id]]]]]]]}}" class="comment-preview-text" bindtap="__e">{{"查看全部 "+post.$orig.comment_count+" 条评论"}}</text></view></block></view></block></view></block></block><block wx:if="{{$root.g5}}"><view class="load-more"><block wx:if="{{loadingMore}}"><text>加载中...</text></block><block wx:else><block wx:if="{{hasMore}}"><text data-event-opts="{{[['tap',[['loadMore',['$event']]]]]}}" bindtap="__e">加载更多</text></block><block wx:else><text>— 已加载全部 —</text></block></block></view></block></view></view><view data-event-opts="{{[['tap',[['openPostSheet',['$event']]]]]}}" class="float-btn" bindtap="__e"><image class="float-icon" src="/static/ui/icons/ic-post.svg" mode="aspectFit"></image></view><block wx:if="{{postSheetVisible}}"><view data-event-opts="{{[['tap',[['closePostSheet',['$event']]]]]}}" class="sheet-mask" bindtap="__e"></view></block><block wx:if="{{postSheetVisible}}"><view class="post-sheet"><view class="sheet-handle"></view><view class="sheet-head"><view><text class="sheet-title">发布新帖子</text><text class="sheet-subtitle">分享作物问题、识别案例或防治经验</text></view><text data-event-opts="{{[['tap',[['closePostSheet',['$event']]]]]}}" class="sheet-close" bindtap="__e">关闭</text></view><scroll-view class="sheet-scroll" scroll-y="{{true}}"><view class="editor-card"><textarea class="post-textarea" maxlength="500" placeholder="说点什么，例如病害现象、处理经验、用药建议..." placeholder-class="textarea-placeholder" data-event-opts="{{[['input',[['__set_model',['$0','content','$event',['trim']],['postForm']]]],['blur',[['$forceUpdate']]]]}}" value="{{postForm.content}}" bindinput="__e" bindblur="__e"></textarea><view class="counter-row"><text>{{$root.g6+"/500"}}</text></view></view><view class="image-editor-card"><view class="image-editor-head"><text class="image-editor-title">图片</text><text class="image-editor-tip">{{$root.g7+"/9"}}</text></view><view class="selected-grid"><block wx:for="{{postForm.images}}" wx:for-item="img" wx:for-index="index" wx:key="index"><view class="selected-img-wrap"><image class="selected-img" src="{{img}}" mode="aspectFill" data-event-opts="{{[['tap',[['previewLocalImages',[index]]]]]}}" bindtap="__e"></image><view data-event-opts="{{[['tap',[['removeLocalImage',[index]]]]]}}" class="remove-img" catchtap="__e">×</view></view></block><block wx:if="{{$root.g8<9}}"><view data-event-opts="{{[['tap',[['choosePostImages',['$event']]]]]}}" class="add-img" bindtap="__e"><image class="add-img-icon" src="/static/ui/icons/ic-upload.svg" mode="aspectFit"></image><text>添加图片</text></view></block></view></view></scroll-view><view class="sheet-footer"><button class="submit-btn" loading="{{publishing}}" disabled="{{publishing}}" data-event-opts="{{[['tap',[['submitPost',['$event']]]]]}}" bindtap="__e"><text class="submit-btn-text">{{publishing?'发布中...':'发布帖子'}}</text></button></view></view></block><block wx:if="{{commentSheetVisible}}"><view data-event-opts="{{[['tap',[['closeComments',['$event']]]]]}}" class="sheet-mask" bindtap="__e"></view></block><block wx:if="{{commentSheetVisible}}"><view class="comment-sheet"><view class="sheet-handle"></view><view class="sheet-head compact"><view><text class="sheet-title">评论</text><text class="sheet-subtitle">{{(activePost?activePost.comment_count||0:0)+" 条讨论"}}</text></view><text data-event-opts="{{[['tap',[['closeComments',['$event']]]]]}}" class="sheet-close" bindtap="__e">关闭</text></view><scroll-view class="comment-scroll" scroll-y="{{true}}"><block wx:if="{{activePost}}"><view class="comment-source"><view class="comment-source-head"><view class="mini-avatar">{{$root.m2}}</view><text class="comment-source-name">{{activePost.username||'农友'}}</text></view><text class="comment-source-text">{{activePost.content||'图片分享'}}</text></view></block><block wx:if="{{commentsLoading}}"><view class="state-box compact-state"><text class="state-text">正在加载评论...</text></view></block><block wx:else><block wx:if="{{$root.g9===0}}"><view class="empty-box comment-empty"><image class="empty-image small" src="/static/ui/empty/empty-posts.png" mode="aspectFit"></image><text class="empty-title">暂无评论</text><text class="empty-desc">留