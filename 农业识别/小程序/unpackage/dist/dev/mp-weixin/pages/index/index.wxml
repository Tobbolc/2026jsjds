<view class="index-page"><view class="hero-section"><image class="hero-bg" src="/static/ui/backgrounds/bg-index-hero.png" mode="aspectFill"></image><view class="hero-overlay"></view><view class="hero-blob hero-blob-left"></view><view class="hero-blob hero-blob-right"></view><image class="hero-decor hero-decor-tl" src="/static/ui/decor/leaf-corner-tl.png" mode="aspectFit"></image><image class="hero-decor hero-decor-br" src="/static/ui/decor/leaf-corner-br.png" mode="aspectFit"></image><view class="hero-content"><view class="brand-chip"><image class="brand-chip-icon" src="/static/ui/decor/leaf-mini-badge.png" mode="aspectFit"></image><text class="brand-chip-text">慧农之眼</text></view><view class="hero-title">识别中心</view><view class="hero-subtitle">上传叶片图片，快速完成病虫害识别</view></view></view><view class="content-wrap"><view class="welcome-card card"><view class="welcome-left"><view class="avatar-badge">{{userInitial}}</view><view class="welcome-meta"><text class="welcome-title">{{userInfo?'欢迎回来，'+userInfo.username:'欢迎使用慧农之眼'}}</text><view class="welcome-tags"><text class="welcome-tag">智能识别</text><text class="welcome-tag">科学防治</text></view></view></view><view data-event-opts="{{[['tap',[['handleAuthAction',['$event']]]]]}}" class="welcome-action" bindtap="__e"><text>{{userInfo?'退出':'登录'}}</text></view></view><view class="card section-card recognize-card"><view class="section-head"><view class="section-mark"></view><text class="section-title">病虫害识别</text></view><view data-event-opts="{{[['tap',[['chooseImage',['$event']]]]]}}" class="upload-box" bindtap="__e"><block wx:if="{{selectedImage}}"><image class="upload-preview" src="{{selectedImage}}" mode="aspectFill"></image><view class="upload-mask"><view class="upload-mask-btn">重新选择</view></view></block><block wx:else><image class="upload-empty" src="/static/ui/empty/empty-upload.png" mode="aspectFit"></image><text class="upload-title">点击上传图片</text><text class="upload-desc">支持 JPG、PNG 格式，建议上传清晰叶片图像</text></block></view><button class="primary-btn" loading="{{submitting}}" disabled="{{submitting}}" data-event-opts="{{[['tap',[['handleRecognize',['$event']]]]]}}" bindtap="__e"><text class="primary-btn-text">{{submitting?'识别中...':'开始识别'}}</text></button></view><block wx:if="{{resultData&&resultData.diseaseInfo}}"><view class="card section-card result-card"><view class="section-head section-head-between"><view class="section-head-left"><view class="section-mark"></view><text class="section-title">识别结果</text></view><view class="{{['severity-badge',severityBadgeClass]}}">{{''+$root.m0+''}}</view></view><view class="result-summary"><view class="summary-item"><text class="summary-label">作物类型</text><text class="summary-value">{{resultData.cropInfo&&resultData.cropInfo.cropName||'未知'}}</text></view><view class="summary-item"><text class="summary-label">病害名称</text><text class="summary-value highlight">{{resultData.diseaseInfo&&resultData.diseaseInfo.diseaseName||'未知'}}</text></view><view class="summary-item"><text class="summary-label">识别置信度</text><text class="summary-value">{{$root.m1}}</text></view></view><block wx:if="{{resultData.solution}}"><view class="result-panel"><block wx:if="{{resultData.solution.symptoms}}"><view class="result-block"><text class="result-block-title">症状特征</text><text class="result-block-text">{{resultData.solution.symptoms}}</text></view></block><block wx:if="{{resultData.solution.solutions}}"><view class="result-block"><text class="result-block-title">防治建议</text><text class="result-block-text">{{resultData.solution.solutions}}</text></view></block><block wx:if="{{resultData.solution.preventionMethods}}"><view class="result-block"><text class="result-block-title">预防措施</text><text class="result-block-text">{{resultData.solution.preventionMethods}}</text></view></block></view></block></view></block><view class="card section-card recent-card"><view class="section-head section-head-between"><view class="section-head-left"><view class="section-mark"></view><text class="section-title">最近识别</text></view><text data-event-opts="{{[['tap',[['refreshHistory',['$event']]]]]}}" class="section-link" bindtap="__e">刷新</text></view><block wx:if="{{!userInfo}}"><view class="empty-box small-empty"><image class="empty-image" src="/static/ui/empty/empty-history.png" mode="aspectFit"></image><text class="empty-title">登录后可查看识别历史</text><text class="empty-desc">系统会自动保存你的识别记录与结果摘要</text></view></block><block wx:else><block wx:if="{{historyLoading}}"><view class="loading-box"><text class="loading-text">正在加载历史记录...</text></view></block><block wx:else><block wx:if="{{$root.g0===0}}"><view class="empty-box small-empty"><image class="empty-image" src="/static/ui/empty/empty-history.png" mode="aspectFit"></image><text class="empty-title">还没有识别记录</text><text class="empty-desc">完成一次图片识别后，记录会自动保存在这里</text></view></block><block wx:else><view class="record-list"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i0__" wx:key="recordId"><view data-event-opts="{{[['tap',[['openRecordDetail',['$0'],[[['recentRecords','recordId',item.$orig.recordId]]]]]]]}}" class="record-item" bindtap="__e"><image class="record-thumb" src="{{item.m2}}" mode="aspectFill"></image><view class="record-body"><view class="record-top"><text class="record-name">{{item.$orig.diseaseName||'未知病害'}}</text><text class="record-time">{{item.$orig.createTime}}</text></view><view class="record-meta-row"><text class="record-chip">{{item.$orig.cropName||'未知作物'}}</text><text class="record-chip soft">{{item.m3}}</text></view></view></view></block></view></block></block></block></view></view><block wx:if="{{detailVisible}}"><view data-event-opts="{{[['tap',[['closeDetail',['$event']]]]]}}" class="detail-mask" bindtap="__e"></view></block><block wx:if="{{detailVisible}}"><view class="detail-sheet"><view class="detail-handle"></view><view class="detail-head"><text class="detail-title">识别详情</text><text data-event-opts="{{[['tap',[['closeDetail',['$event']]]]]}}" class="detail-close" bindtap="__e">关闭</text></view><scroll-view class="detail-scroll" scroll-y="{{true}}"><block wx:if="{{detailData}}"><view class="detail-card"><image class="detail-image" src="{{$root.m4}}" mode="aspectFill"></image><view class="detail-summary"><view class="detail-row"><text class="detail-label">作物</text><text class="detail-value">{{detailData.cropInfo&&detailData.cropInfo.cropName||'未知'}}</text></view><view class="detail-row"><text class="detail-label">病害</text><text class="detail-value highlight">{{detailData.diseaseInfo&&detailData.diseaseInfo.diseaseName||'未知'}}</text></view><view class="detail-row"><text class="detail-label">严重程度</text><text class="detail-value">{{$root.m5}}</text></view><view class="detail-row"><text class="detail-label">置信度</text><text class="detail-value">{{$root.m6}}</text></view></view><block wx:if="{{detailData.solution&&detailData.solution.symptoms}}"><view class="detail-block"><text class="detail-block-title">症状特征</text><text class="detail-block-text">{{detailData.solution.symptoms}}</text></view></block><block wx:if="{{detailData.solution&&detailData.solution.solutions}}"><view class="detail-block"><text class="detail-block-title">防治建议</text><text class="detail-block-text">{{detailData.solution.solutions}}</text></view></block><block wx:if="{{detailData.solution&&detailData.solution.preventionMethods}}"><view class="detail-block"><text class="detail-block-title">预防措施</text><text class="detail-block-text">{{detailData.solution.preventionMethods}}</text></view></block></view></block></scroll-view></view></block></view>