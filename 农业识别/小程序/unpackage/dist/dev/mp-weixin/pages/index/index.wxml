<view class="container"><view class="content"><view class="main"><view class="user-card"><view class="user-info"><text class="welcome">{{"欢迎，"+userInfo.username}}</text><text data-event-opts="{{[['tap',[['handleLogout',['$event']]]]]}}" class="logout" bindtap="__e">退出登录</text></view></view><view class="function-card"><view class="card-title">病虫害识别</view><view class="upload-section"><view data-event-opts="{{[['tap',[['chooseImage',['$event']]]]]}}" class="upload-box" bindtap="__e"><block wx:if="{{tempFilePath}}"><image class="preview-image" src="{{tempFilePath}}" mode="aspectFit"></image></block><block wx:else><view class="upload-placeholder"><uni-icons vue-id="8dd740cc-1" type="camera-filled" size="40" color="#999" bind:__l="__l"></uni-icons><text class="upload-text">点击上传图片</text><text class="upload-desc">支持jpg、png格式</text></view></block></view></view><button class="submit-btn" disabled="{{!tempFilePath}}" data-event-opts="{{[['tap',[['submitImage',['$event']]]]]}}" bindtap="__e">开始识别</button></view><view class="history-card"><view class="card-title">最近识别</view><scroll-view class="history-list" style="{{'height:'+('600rpx')+';'}}" scroll-y="{{true}}" show-scrollbar="{{false}}" lower-threshold="{{50}}" data-event-opts="{{[['scrolltolower',[['loadMore',['$event']]]]]}}" bindscrolltolower="__e"><block wx:if="{{!$root.g0}}"><view class="empty-tip">暂无识别记录</view></block><block wx:else><view><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['showHistoryDetail',['$0'],[[['historyList','',index]]]]]]]}}" class="history-item" bindtap="__e"><image class="history-image" src="{{item.m0}}" mode="aspectFill"></image><view class="history-info"><text class="disease-name">{{item.$orig.diseaseName}}</text><text class="crop-name">{{"作物："+item.$orig.cropName}}</text><text class="confidence">{{"置信度: "+item.$orig.confidence+"%"}}</text><text class="time">{{item.$orig.createTime}}</text></view></view></block><block wx:if="{{isLoading}}"><view class="loading-more"><text>加载中...</text></view></block><block wx:if="{{$root.g1}}"><view class="no-more"><text>没有更多了</text></view></block></view></block></scroll-view></view><block wx:if="{{showResultPopup}}"><view data-event-opts="{{[['tap',[['closePopup',['$event']]]]]}}" class="popup-mask" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="popup-content" catchtap="__e"><view class="popup-header"><text class="popup-title">识别结果</text><text data-event-opts="{{[['tap',[['closePopup',['$event']]]]]}}" class="popup-close" bindtap="__e">×</text></view><block wx:if="{{recognitionResult}}"><view class="popup-body"><view class="result-item"><text class="label">作物类型：</text><text class="value">{{recognitionResult.cropInfo.cropName}}</text></view><view class="result-item"><text class="label">识别结果：</text><text class="{{['value',$root.m1]}}">{{''+recognitionResult.diseaseInfo.diseaseName+''}}</text></view><view class="result-item"><text class="label">置信度：</text><text class="value">{{recognitionResult.diseaseInfo.confidence+"%"}}</text></view><view class="result-item"><text class="label">严重程度：</text><text class="{{['value',$root.m2]}}">{{''+recognitionResult.diseaseInfo.severityLevel+''}}</text></view><view class="divider"></view><view class="solution-section"><text class="solution-section-subtitle">症状描述</text><text class="solution-section-content">{{recognitionResult.solution.symptoms||'暂无数据'}}</text><text class="solution-section-subtitle">解决方案</text><text class="solution-section-content">{{recognitionResult.solution.solutions||'暂无数据'}}</text><text class="solution-section-subtitle">预防措施</text><text class="solution-section-content">{{recognitionResult.solution.preventionMethods||'暂无数据'}}</text></view></view></block></view></view></block></view></view></view>