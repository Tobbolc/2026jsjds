
.login-container {
  min-height: 100vh;
  background-color: #2C8A43;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.content {
  flex: 1;
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  min-height: 100%;
}
.header {
  margin-bottom: 100rpx;
  color: #fff;
  text-align: center;
}
.title {
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
}
.subtitle {
  font-size: 32rpx;
  opacity: 0.9;
  letter-spacing: 2rpx;
}
.card {
  background: #fff;
  border-radius: 30rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.1);
}
.switch-mode {
  display: flex;
  margin-bottom: 60rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  padding: 8rpx;
}
.mode-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 32rpx;
  color: #666;
  border-radius: 12rpx;
  font-weight: 500;
}
.mode-btn.active {
  background: #2C8A43;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(44,138,67,0.3);
}
.input-group {
  margin-bottom: 40rpx;
}
.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  margin-left: 20rpx;
  font-weight: 500;
}
.input {
  width: 100%;
  height: 100rpx;
  background: #f8f8f8;
  border-radius: 50rpx;
  padding: 0 40rpx;
  font-size: 30rpx;
  color: #333;
  border: 2rpx solid #f0f0f0;
  box-sizing: border-box;
}
.input:focus {
  background: #fff;
  border-color: #2C8A43;
  box-shadow: 0 4rpx 12rpx rgba(44,138,67,0.1);
}
.input::-webkit-input-placeholder {
  color: #bbb;
}
.input::placeholder {
  color: #bbb;
}
.submit-btn {
  margin-top: 80rpx;
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background-color: #2C8A43;
  color: #fff;
  font-size: 34rpx;
  border-radius: 50rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(44,138,67,0.3);
  border: none;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.submit-btn:active {
  opacity: 0.9;
}
.footer-text {
  margin-top: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  padding-bottom: 40rpx;
}

