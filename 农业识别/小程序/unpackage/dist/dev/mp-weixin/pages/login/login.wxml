 class="field-icon field-icon-lock"></view><input class="field-input" password="{{!showPassword}}" placeholder="请输入密码" placeholder-class="field-placeholder" confirm-type="done" data-event-opts="{{[['input',[['__set_model',['$0','password','$event',['trim']],['formData']]]],['blur',[['$forceUpdate']]]]}}" value="{{formData.password}}" bindinput="__e" bindblur="__e"/><text data-event-opts="{{[['tap',[['togglePassword',['$event']]]]]}}" class="field-action" bindtap="__e">{{showPassword?'隐藏':'显示'}}</text></view></view><block wx:if="{{!isLogin}}"><view class="field-group"><text class="field-label">确认密码</text><view class="field-box"><view class="field-icon field-icon-check"></view><input class="field-input" password="{{!showConfirmPassword}}" placeholder="请再次输入密码" placeholder-class="field-placeholder" data-event-opts="{{[['input',[['__set_model',['$0','confirmPassword','$event',['trim']],['formData']]]],['blur',[['$forceUpdate']]]]}}" value="{{formData.confirmPassword}}" bindinput="__e" bindblur="__e"/><text data-event-opts="{{[['tap',[['toggleConfirmPassword',['$event']]]]]}}" class="field-action" bindtap="__e">{{showConfirmPassword?'隐藏':'显示'}}</text></view></view><view class="field-group"><text class="field-label">邮箱</text><view class="field-box"><view class="field-icon field-icon-mail"></view><input class="field-input" placeholder="请输入邮箱（选填）" placeholder-class="field-placeholder" data-event-opts="{{[['input',[['__set_model',['$0','email','$event',['trim']],['formData']]]],['blur',[['$forceUpdate']]]]}}" value="{{formData.email}}" bindinput="__e" bindblur="__e"/></view></view><view class="field-group"><text class="field-label">手机号</text><view class="field-box"><view class="field-icon field-icon-phone"></view><input class="field-input" type="number" placeholder="请输入手机号（选填）" placeholder-class="field-placeholder" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',['trim']],['formData']]]],['blur',[['$forceUpdate']]]]}}" value="{{formData.phone}}" bindinput="__e" bindblur="__e"/></view></view></block><view class="submit-area"><button class="submit-btn" loading="{{submitting}}" disabled="{{submitting}}" data-event-opts="{{[['tap',[['handleSubmit',['$event']]]]]}}" bindtap="__e"><text class="submit-btn-text">{{submitting?isLogin?'登录中...':'注册中...':isLogin?'登 录':'注 册'}}</text></button></view></view></view><view class="agreement-text">{{''+(isLogin?'登录':'注册')+'即代表同意'}}<text class="agreement-link">《用户协议》</text>和<text class="agreement-link">《隐私政策》</text></view></view><view class="page-glow page-glow-left"></view><view class="page-glow page-glow-right"></view></view>