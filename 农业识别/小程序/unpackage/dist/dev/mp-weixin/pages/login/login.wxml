<view class="login-container"><view class="content"><view class="header"><view class="title">智慧农业</view><view class="subtitle">病虫害智能识别与预警系统</view></view><view class="card"><view class="switch-mode"><view data-event-opts="{{[['tap',[['switchMode',[true]]]]]}}" class="{{['mode-btn',isLogin?'active':'']}}" bindtap="__e">登录</view><view data-event-opts="{{[['tap',[['switchMode',[false]]]]]}}" class="{{['mode-btn',!isLogin?'active':'']}}" bindtap="__e">注册</view></view><view class="form-section"><view class="input-group"><text class="label">账号</text><input class="input" placeholder="请输入用户名" data-event-opts="{{[['input',[['__set_model',['$0','username','$event',[]],['formData']]]]]}}" value="{{formData.username}}" bindinput="__e"/></view><view class="input-group"><text class="label">密码</text><input class="input" type="password" placeholder="请输入密码" data-event-opts="{{[['input',[['__set_model',['$0','password','$event',[]],['formData']]]]]}}" value="{{formData.password}}" bindinput="__e"/></view><block wx:if="{{!isLogin}}"><view class="input-group"><text class="label">确认密码</text><input class="input" type="password" placeholder="请再次输入密码" data-event-opts="{{[['input',[['__set_model',['$0','confirmPassword','$event',[]],['formData']]]]]}}" value="{{formData.confirmPassword}}" bindinput="__e"/></view><view class="input-group"><text class="label">邮箱</text><input class="input" type="text" placeholder="请输入邮箱" data-event-opts="{{[['input',[['__set_model',['$0','email','$event',[]],['formData']]]]]}}" value="{{formData.email}}" bindinput="__e"/></view><view class="input-group"><text class="label">手机号</text><input class="input" type="number" placeholder="请输入手机号" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['formData']]]]]}}" value="{{formData.phone}}" bindinput="__e"/></view></block></view><button data-event-opts="{{[['tap',[['handleSubmit',['$event']]]]]}}" class="submit-btn" bindtap="__e">{{''+(isLogin?'登 录':'注 册')+''}}</button></view><view class="footer-text">登录即代表同意《用户协议》和《隐私政策》</view></view></view>